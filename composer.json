{
    "name": "nanxihang/wechat",
    "description": "WeChat SDK Library for PHP",
    "type": "library",
    "keywords": ["wechat", "weixin", "sdk", "api"],
    "homepage": "https://github.com/yynonline/nxh-wechat",
    "license": "MIT",
    "authors": [
        {
            "name": "huyoujin",
            "email": "huyoujin@ibabyzone.cn",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=5.6.0",
        "ext-curl": "*",
        "ext-openssl": "*",
        "ext-simplexml": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^5.0 || ^6.0 || ^7.0 || ^8.0 || ^9.0"
    },
    "autoload": {
        "psr-4": {
            "Nanxihang\\Wechat\\": "src/",
            "Nanxihang\\Wechat\\Internal\\": "src/Internal/"
        },
        "files": [
            "src/errCode.php",
            "src/qyerrCode.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Nanxihang\\Wechat\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
